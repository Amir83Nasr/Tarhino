# Production env template.
# Copy values 1:1 into your deploy platform (Vercel project env / fly secrets).
# Replace every <PLACEHOLDER> before deploying. Never commit real values.

# ── APP ────────────────────────────────────────────────────
APP_ENV=production
APP_NAME=Tarhino

# ── DATABASE ───────────────────────────────────────────────
# Neon production pooled connection string (pooled(-pooler) host, not direct)
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<POOLER-HOST>.pg.neon.tech/<DBNAME>?sslmode=require

# ── AUTH / SECURITY ────────────────────────────────────────
# generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<GENERATE-NEW-DO-NOT-REUSE-DEV>
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# https in production
REFRESH_COOKIE_SECURE=true
# none: web on Vercel (*.vercel.app / custom domain) and API on another domain (e.g. Fly)
# lax:  only if web + api share one registrable domain behind a reverse proxy
REFRESH_COOKIE_SAMESITE=none

# ── AI (server-controlled, set as secrets on the API host) ──
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=liquid/lfm-2.5-2.6b:free
AI_API_KEY=<PROVIDER-KEY>

# ── CORS ───────────────────────────────────────────────────
# comma-separated, no trailing slashes
CORS_ORIGINS=https://<WEB-PRODUCTION-DOMAIN>

# ── WEB (Next.js, public — Vercel env vars) ────────────────
NEXT_PUBLIC_API_URL=https://<API-HOST>/api/v1
