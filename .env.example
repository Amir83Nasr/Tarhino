# ── APP ────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=Tarhino

# ── DATABASE ───────────────────────────────────────────────
# Dev: local Docker Postgres (`docker compose up -d db`).
# Prod: Neon pooled connection string, e.g.
# postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://tarhino:tarhino@localhost:5432/tarhino

# ── AUTH / SECURITY ────────────────────────────────────────
# generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# false when serving the API over plain HTTP on the LAN (phones cannot store Secure cookies)
REFRESH_COOKIE_SECURE=true
# lax when web + api share a domain, none when they do not (requires HTTPS)
REFRESH_COOKIE_SAMESITE=lax

# ── AI (server-controlled, never exposed to teachers) ──────
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=liquid/lfm-2.5-2.6b:free
AI_API_KEY=

# ── CORS ───────────────────────────────────────────────────
# add http://<lan-ip>:3000 when testing from a phone on the same Wi-Fi
CORS_ORIGINS=http://localhost:3000,http://192.168.1.20:3000

# ── WEB (Next.js, public) ──────────────────────────────────
# point at http://<lan-ip>:8000/api/v1 to reach the API from a phone
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1